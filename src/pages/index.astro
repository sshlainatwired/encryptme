---
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="ledger-wrap">
    <!-- Ledger header -->
    <header class="masthead" data-reveal>
      <div class="mh-left">
        <span class="mh-seal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4.5" y="10.5" width="15" height="9.5" rx="1.2" />
            <path d="M7.8 10.5V7.6a4.2 4.2 0 0 1 8.4 0v2.9" />
          </svg>
        </span>
        <div class="mh-name">
          <span class="mh-title">EncryptMe</span>
        </div>
      </div>
      <div class="mh-right">
        <button type="button" class="lamp-toggle" data-act="toggle-theme" aria-label="Switch page lighting">
          <svg class="ic-lamp-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 3v2.4M4.6 6.6l1.7 1.7M19.4 6.6l-1.7 1.7M3 13h2.6M18.4 13H21" />
            <path d="M8.5 13a3.5 3.5 0 1 1 7 0c0 2.1-1.6 2.6-1.9 4.3H10.4C10.1 15.6 8.5 15.1 8.5 13Z" />
            <path d="M10.2 20h3.6" />
          </svg>
          <svg class="ic-lamp-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Console -->
    <div class="console" data-reveal>
      <div role="tablist" class="tabs">
        <button data-tab="encrypt" class="tab">Encrypt</button>
        <button data-tab="decrypt" class="tab">Decrypt</button>
        <button data-tab="keys" class="tab">Keys</button>
      </div>

      <!-- ENCRYPT -->
      <section data-panel="encrypt" class="panel flex-col gap-5">
        <label class="slot" data-zone="encrypt">
          <span class="slot-title">Drop files here, or click to choose</span>
          <span class="slot-sub" data-files="encrypt">No files selected</span>
          <input type="file" multiple class="sr-only" data-input="encrypt" />
        </label>

        <div class="field-group">
          <span class="label">Lock with</span>
          <div class="seg">
            <button data-mode="encrypt" data-value="password" class="modebtn">Password</button>
            <button data-mode="encrypt" data-value="key" class="modebtn">Recipient's key</button>
          </div>
        </div>

        <div data-sub="encrypt-password" class="flex-col gap-3">
          <div class="row">
            <input type="password" data-el="enc-pw" placeholder="Password"
              autocomplete="new-password" class="field" />
            <button data-act="toggle-enc-pw" class="ghost" type="button">show</button>
            <button data-act="gen-pw" class="ghost ghost-moss" type="button">generate</button>
          </div>
          <input type="password" data-el="enc-pw2" placeholder="Confirm password"
            autocomplete="new-password" class="field" />
          <div class="row items-center">
            <div class="meter-track">
              <div data-el="pw-meter" class="meter-fill w-0"></div>
            </div>
            <span data-el="pw-label" class="label tnum">&mdash;</span>
          </div>
          <label class="label range-row">
            length
            <input type="range" data-el="pw-len" min="12" max="48" value="20" class="range" />
            <span data-el="pw-len-val" class="tnum">20</span>
          </label>
        </div>

        <div data-sub="encrypt-key" class="hidden flex-col gap-2">
          <textarea data-el="enc-recipient" rows="2"
            placeholder="Recipient public key (base64)" class="field"></textarea>
          <p class="hint">
            Ask your recipient to open the Keys tab, generate a keypair, and send you their public key.
          </p>
        </div>

        <button data-act="encrypt" class="btn">Encrypt</button>
      </section>

      <!-- DECRYPT -->
      <section data-panel="decrypt" class="panel hidden flex-col gap-5">
        <label class="slot" data-zone="decrypt">
          <span class="slot-title">Drop a .enc file here, or click to choose</span>
          <span class="slot-sub" data-files="decrypt">No file selected</span>
          <input type="file" class="sr-only" data-input="decrypt" />
        </label>

        <p data-el="dec-detected" class="detected hidden"></p>

        <div data-sub="decrypt-password" class="row">
          <input type="password" data-el="dec-pw" placeholder="Password"
            autocomplete="off" class="field" />
          <button data-act="toggle-dec-pw" class="ghost" type="button">show</button>
        </div>

        <div data-sub="decrypt-key" class="hidden flex-col gap-2">
          <textarea data-el="dec-pub" rows="2" placeholder="Your public key (base64)"
            class="field"></textarea>
          <textarea data-el="dec-sec" rows="2" placeholder="Your secret key (base64)"
            class="field"></textarea>
        </div>

        <button data-act="decrypt" class="btn">Decrypt</button>
      </section>

      <!-- KEYS -->
      <section data-panel="keys" class="panel hidden flex-col gap-5">
        <p class="hint">
          Generate an X25519 keypair. Share your <b>public</b> key so others can encrypt
          files to you. Don't share your <b>secret</b> key &mdash; anyone who has it can
          decrypt those files.
        </p>
        <button data-act="genkeys" class="btn">Generate keypair</button>

        <div data-el="keys-out" class="hidden flex-col gap-5">
          <div class="field-group">
            <span class="label">Public key</span>
            <textarea data-el="out-pub" rows="2" readonly class="field"></textarea>
            <div class="row">
              <button data-act="copy-pub" class="ghost">copy</button>
              <button data-act="dl-pub" class="ghost">download</button>
            </div>
          </div>
          <div class="field-group danger-zone">
            <span class="label label-danger">Secret key &mdash; don't share it</span>
            <textarea data-el="out-sec" rows="2" readonly class="field"></textarea>
            <div class="row">
              <button data-act="reveal-sec" class="ghost">reveal</button>
              <button data-act="copy-sec" class="ghost">copy</button>
              <button data-act="dl-sec" class="ghost">download</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Status / progress (shared) -->
      <div data-el="status" class="status hidden flex-col gap-2">
        <div class="row items-center justify-between">
          <span data-el="status-text" class="label tnum"></span>
          <button data-act="cancel" class="ghost">cancel</button>
        </div>
        <div class="stream">
          <div data-el="bar" class="streamfill w-0"></div>
        </div>
      </div>

      <div data-el="result" class="hidden"></div>
    </div>

    <footer class="foot">
      no analytics &middot; no cookies &middot; open source &middot; inspired by hat.sh
    </footer>
  </main>
</Base>

<script>
  import { initApp } from "../scripts/app";
  initApp();
</script>

<style>
  .ledger-wrap {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem) 1.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  [data-reveal] {
    animation: rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .console[data-reveal] {
    animation-delay: 0.06s;
  }

  /* ── Masthead ────────────────────────────────────────────────────── */
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--rule-strong);
  }
  .mh-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .mh-seal {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    border: 1.5px solid var(--rule-strong);
  }
  .mh-seal svg {
    height: 1.05rem;
    width: 1.05rem;
  }
  .mh-name {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .mh-title {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .mh-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lamp-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    width: 2rem;
    color: var(--muted);
    background: transparent;
    border: 1.5px solid var(--rule-strong);
    transition: color 0.15s, border-color 0.15s;
  }
  .lamp-toggle:hover {
    color: var(--gold);
    border-color: var(--gold);
  }
  .lamp-toggle svg {
    height: 1rem;
    width: 1rem;
  }
  .lamp-toggle .ic-lamp-off {
    display: none;
  }
  :root[data-theme="light"] .lamp-toggle .ic-lamp-off {
    display: block;
  }
  :root[data-theme="light"] .lamp-toggle .ic-lamp-on {
    display: none;
  }

  /* ── Console sheet ───────────────────────────────────────────────── */
  .console {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: clamp(1.1rem, 3.6vw, 1.75rem);
    background: var(--page);
    border: 1.5px solid var(--rule-strong);
    box-shadow: 0 22px 46px -30px var(--shadow);
  }

  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1.5px solid var(--rule-strong);
  }
  .tab {
    padding: 0.55rem 0.2rem;
    margin-bottom: -1.5px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    background: transparent;
    border-bottom: 2.5px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab + .tab {
    margin-left: 1.1rem;
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--moss);
  }

  .seg {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border: 1.5px solid var(--rule-strong);
    overflow: hidden;
  }
  .modebtn {
    padding: 0.5rem 0.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    background: transparent;
    border-right: 1.5px solid var(--rule-strong);
    transition: color 0.15s, background 0.15s;
  }
  .modebtn:last-child {
    border-right: none;
  }
  .modebtn:hover {
    color: var(--ink);
  }
  .modebtn[aria-selected="true"] {
    color: var(--moss-ink);
    background: var(--moss);
  }

  /* Layout helpers */
  .panel {
    display: flex;
  }
  .panel.hidden {
    display: none;
  }
  .flex-col {
    display: flex;
    flex-direction: column;
  }
  .gap-2 {
    gap: 0.5rem;
  }
  .gap-3 {
    gap: 0.75rem;
  }
  .gap-5 {
    gap: 1.15rem;
  }
  .row {
    display: flex;
    gap: 0.5rem;
  }
  .items-center {
    align-items: center;
  }
  .justify-between {
    justify-content: space-between;
  }
  .hidden {
    display: none;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  [data-sub].flex {
    display: flex;
  }

  .label {
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tnum {
    font-variant-numeric: tabular-nums;
  }
  .hint {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .hint b {
    color: var(--ink);
    font-weight: 600;
  }

  /* Insert slot (dropzone) */
  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.9rem 1rem;
    text-align: center;
    cursor: pointer;
    background: var(--page-recessed);
    border: 1.5px dashed var(--rule-strong);
    transition: border-color 0.15s, background 0.15s;
  }
  .slot:hover,
  .slot.is-drag {
    border-color: var(--moss);
  }
  .slot.is-drag {
    background: color-mix(in srgb, var(--moss) 12%, var(--page-recessed));
  }
  .slot-title {
    font-size: 0.88rem;
    font-weight: 600;
  }
  .slot-sub {
    font-size: 0.72rem;
    color: var(--muted);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Fields */
  .field {
    width: 100%;
    padding: 0.6rem 0.72rem;
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--page-recessed);
    border: 1.5px solid var(--rule);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  textarea.field {
    resize: vertical;
    line-height: 1.5;
    word-break: break-all;
  }
  .field::placeholder {
    color: color-mix(in srgb, var(--muted) 85%, transparent);
  }
  .field:focus-visible {
    border-color: var(--moss);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--moss) 25%, transparent);
  }
  .row > .field {
    flex: 1;
  }

  /* Strength meter */
  .meter-track {
    flex: 1;
    height: 6px;
    background: var(--page-recessed);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .meter-fill {
    height: 100%;
    transition: width 0.2s ease, background 0.2s ease;
    background: var(--muted);
  }
  .meter-fill.score-0 {
    background: var(--muted);
  }
  .meter-fill.score-1 {
    background: var(--rust);
  }
  .meter-fill.score-2 {
    background: var(--gold);
  }
  .meter-fill.score-3 {
    background: color-mix(in srgb, var(--moss) 70%, var(--gold));
  }
  .meter-fill.score-4 {
    background: var(--moss);
  }

  .range-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .range {
    flex: 1;
    accent-color: var(--moss);
  }

  /* Buttons — the primary is an ink-stamped "posted" mark */
  .btn {
    padding: 0.7rem 1rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--moss-ink);
    background: var(--moss);
    border: 1.5px solid color-mix(in srgb, var(--moss) 70%, black);
    transition: filter 0.15s, transform 0.08s;
  }
  .btn:hover {
    filter: brightness(1.08);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ghost {
    padding: 0.4rem 0.65rem;
    font-size: 0.71rem;
    color: var(--muted);
    background: transparent;
    border: 1.5px solid var(--rule-strong);
    transition: color 0.15s, border-color 0.15s;
  }
  .ghost:hover {
    color: var(--moss);
    border-color: var(--moss);
  }
  .ghost-moss {
    color: var(--moss);
    border-color: color-mix(in srgb, var(--moss) 55%, transparent);
  }

  .detected {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--moss);
    padding: 0.38rem 0.65rem;
    border: 1.5px solid color-mix(in srgb, var(--moss) 45%, transparent);
  }
  .detected:not(.hidden) {
    display: inline-block;
  }

  .danger-zone .field:focus-visible {
    border-color: var(--rust);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rust) 22%, transparent);
  }
  .label-danger {
    color: var(--rust);
  }

  /* Progress: a running tally */
  .status {
    gap: 0.55rem;
  }
  .stream {
    height: 8px;
    background-color: var(--page-recessed);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .streamfill {
    height: 100%;
    background: var(--moss);
    transition: width 0.15s linear;
  }

  /* Result banner */
  [data-el="result"]:not(.hidden) {
    display: block;
    padding: 0.65rem 0.85rem;
    font-size: 0.85rem;
    border: 1.5px solid transparent;
  }
  [data-el="result"].result-ok {
    color: var(--moss);
    border-color: color-mix(in srgb, var(--moss) 45%, transparent);
  }
  [data-el="result"].result-err {
    color: var(--rust);
    border-color: color-mix(in srgb, var(--rust) 45%, transparent);
  }

  .foot {
    text-align: center;
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--muted) 85%, transparent);
  }

  /* Motion */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .streamfill,
    .btn {
      animation: none;
      transition: none;
    }
  }
</style>
